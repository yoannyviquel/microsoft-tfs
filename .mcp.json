{
  "mcpServers": {
    "tfs": {
      "type": "stdio",
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/server.js"],
      "env": {
        "TFS_TOKEN": "${user_config.token}",
        "TFS_BASE_URL": "${user_config.baseUrl}",
        "TFS_ORG": "${user_config.org}"
      }
    }
  }
}
